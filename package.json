{
  "name": "voiceflow-automation",
  "version": "0.0.1",
  "pluginVersion": "bdd23",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^22.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint xyops tests",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:plugin": "PLUGIN_VERSION=$(bun -e \"console.log(require('./package.json').pluginVersion)\") && bun build xyops/plugin/entrypoint.ts --target=node --format=cjs --banner=\"// Voiceflow XYOps Event Plugin v$PLUGIN_VERSION\" --outfile=dist/voiceflow-event-plugin.cjs",
    "build:cli:darwin-arm64": "bun build xyops/cli/index.ts --compile --target=bun-darwin-arm64 --outfile=dist/voiceflow-cli-darwin-arm64",
    "build:cli:darwin-x64": "bun build xyops/cli/index.ts --compile --target=bun-darwin-x64 --outfile=dist/voiceflow-cli-darwin-x64",
    "build:cli:linux-arm64": "bun build xyops/cli/index.ts --compile --target=bun-linux-arm64 --outfile=dist/voiceflow-cli-linux-arm64",
    "build:cli:linux-x64": "bun build xyops/cli/index.ts --compile --target=bun-linux-x64 --outfile=dist/voiceflow-cli-linux-x64",
    "build:cli:windows-x64": "bun build xyops/cli/index.ts --compile --target=bun-windows-x64-baseline --outfile=dist/voiceflow-cli-windows-x64.exe",
    "build:cli": "bun run build:cli:darwin-arm64 && bun run build:cli:darwin-x64 && bun run build:cli:linux-arm64 && bun run build:cli:linux-x64 && bun run build:cli:windows-x64",
    "bdd:18": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/18-logux-wire-frame-fixtures/feature.feature' --import 'bdd/18-logux-wire-frame-fixtures/steps.js'",
    "bdd:19": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/19-migration-parameter-constants/feature.feature' --import 'bdd/19-migration-parameter-constants/steps.js'",
    "bdd:20": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/20-zod-boundary-validation/plugin-boundary.feature' --import 'bdd/20-zod-boundary-validation/steps.js'",
    "bdd:21": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/21-diagnostic-contract-and-redaction/executable.feature' --import 'bdd/21-diagnostic-contract-and-redaction/steps.js'",
    "bdd:22": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/22-authoritative-runtime-state/executable.feature' --import 'bdd/22-authoritative-runtime-state/steps.js'",
    "bdd:23": "bun node_modules/@cucumber/cucumber/bin/cucumber-js 'bdd/23-runtime-boundaries-and-control-flow/feature.feature' --import 'bdd/23-runtime-boundaries-and-control-flow/steps.js'",
    "bdd": "bun run bdd:18 && bun run bdd:19 && bun run bdd:20 && bun run bdd:21 && bun run bdd:22 && bun run bdd:23",
    "verify:cli": "bun scripts/validate-cli-artifacts.ts",
    "probe:network-secrets": "bun scripts/probe-network-secrets.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "zod": "^4.6.5"
  }
}
